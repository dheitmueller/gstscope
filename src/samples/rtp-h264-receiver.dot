  rtph264depay0_src -> h264parse0_sink [label="video/x-h264"];
  h264parse0_src -> avdec_h264_0_sink [label="video/x-h264"];
  avdec_h264_0_src -> videoconvert0_sink [label="video/x-raw"];
  videoconvert0_src -> xvimagesink0_sink [label="video/x-raw"];
