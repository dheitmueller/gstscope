      style="invis";
      audioresample0_src [color=black, fillcolor="#ffaaaa", label="src\n[>][bfb]", height="0.2", style="filled,solid"];
    }
    audioresample0_sink -> audioresample0_src [style="invis"];
  }
  subgraph cluster_autoaudiosink0_3 {
    label="GstAutoAudioSink\nautoaudiosink0\n[>]";
