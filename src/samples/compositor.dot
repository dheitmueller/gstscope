      style="invis";
      xvimagesink0_sink [color=black, fillcolor="#aaaaff", label="sink\n[>][bfb]", height="0.2", style="filled,solid"];
    }
  }
  videotestsrc0_src -> capsfilter0_sink [label="video/x-rawl width: 100l height: 100l framerate: 10/1"];
  capsfilter0_src -> videobox0_sink [label="video/x-raw"];
  videobox0_src -> compositor0_sink_0 [label="video/x-raw"];
  videotestsrc1_src -> capsfilter1_sink [label="video/x-rawl width: 320l height: 240l framerate: 5/1"];
  capsfilter1_src -> compositor0_sink_1 [label="video/x-raw"];
