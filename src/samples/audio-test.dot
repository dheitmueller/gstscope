digraph pipeline {
  rankdir=LR;
  fontname="sans";
  fontsize="10";
  labelloc=t;
  label="<GstPipeline>\naudio-test\n[>]";
  node [style="filled,rounded", shape=box, fontsize="9", fontname="sans", margin="0.0,0.0"];
  edge [labelfontsize="6", fontsize="9", fontname="monospace"];
  subgraph cluster_audiotestsrc0_0 {
    label="GstAudioTestSrc\naudiotestsrc0\n[>]";
    style="filled,rounded";
    color=black;
    fillcolor="#ffffff";
    subgraph cluster_audiotestsrc0_src {
      label="";
      style="invis";
      audiotestsrc0_src [color=black, fillcolor="#ffaaaa", label="src\n[>][bfb]", height="0.2", style="filled,solid"];
    }
  }
  subgraph cluster_audioconvert0_1 {
    label="GstAudioConvert\naudioconvert0\n[>]";
    style="filled,rounded";
    color=black;
    fillcolor="#ffffff";
    subgraph cluster_audioconvert0_sink {
      label="";
      style="invis";
      audioconvert0_sink [color=black, fillcolor="#aaaaff", label="sink\n[>][bfb]", height="0.2", style="filled,solid"];
    }
    subgraph cluster_audioconvert0_src {
      label="";
      style="invis";
      audioconvert0_src [color=black, fillcolor="#ffaaaa", label="src\n[>][bfb]", height="0.2", style="filled,solid"];
    }
    audioconvert0_sink -> audioconvert0_src [style="invis"];
  }
  subgraph cluster_audioresample0_2 {
    label="GstAudioResample\naudioresample0\n[>]";
    style="filled,rounded";
    color=black;
    fillcolor="#ffffff";
    subgraph cluster_audioresample0_sink {
      label="";
      style="invis";
      audioresample0_sink [color=black, fillcolor="#aaaaff", label="sink\n[>][bfb]", height="0.2", style="filled,solid"];
    }
    subgraph cluster_audioresample0_src {
      label="";
      style="invis";
      audioresample0_src [color=black, fillcolor="#ffaaaa", label="src\n[>][bfb]", height="0.2", style="filled,solid"];
    }
    audioresample0_sink -> audioresample0_src [style="invis"];
  }
  subgraph cluster_autoaudiosink0_3 {
    label="GstAutoAudioSink\nautoaudiosink0\n[>]";
    style="filled,rounded";
    color=black;
    fillcolor="#ffffff";
    subgraph cluster_autoaudiosink0_sink {
      label="";
      style="invis";
      autoaudiosink0_sink [color=black, fillcolor="#aaaaff", label="sink\n[>][bfb]", height="0.2", style="filled,solid"];
    }
  }
  audiotestsrc0_src -> audioconvert0_sink [label="audio/x-raw"];
  audioconvert0_src -> audioresample0_sink [label="audio/x-raw"];
  audioresample0_src -> autoaudiosink0_sink [label="audio/x-raw"];
}
